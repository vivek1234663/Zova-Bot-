    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json;\n  let parsed = {};\n\n  try {\n    let text = raw.content.parts[0].text || '';\n    text = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = { _error: e.message };\n  }\n\n  results.push({ json: parsed });\n}\n\nreturn results;"
      },
